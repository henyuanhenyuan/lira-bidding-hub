{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lira",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:LIRA_AUTH='on'; $env:LIRA_SCHEDULER='thread'; $env:LIRA_LLM='on'; $env:LIRA_LLM_BACKEND='gateway'; $env:LIRA_LLM_ROUTE='ollama'; python -m uvicorn app.main:app --host 127.0.0.1 --port 8011"
      ],
      "port": 8011,
      "url": "http://127.0.0.1:8011"
    },
    {
      "name": "lira-live",
      "url": "http://127.0.0.1:8011",
      "port": 8011
    }
  ]
}
