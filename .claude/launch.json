{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "lira",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--host", "127.0.0.1", "--port", "8010"],
      "port": 8010
    },
    {
      "name": "lira-pg",
      "runtimeExecutable": "powershell",
      "runtimeArgs": [
        "-NoProfile",
        "-Command",
        "$env:LIRA_AUTH='off'; $env:LIRA_DATABASE_URL='postgresql://lira:lira@127.0.0.1:5432/lira'; $env:LIRA_SCHEDULER='off'; python -m uvicorn app.main:app --host 127.0.0.1 --port 8010"
      ],
      "port": 8010,
      "url": "http://127.0.0.1:8010"
    }
  ]
}
